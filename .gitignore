# Build artifacts
**/bin/**
**/obj/**
TestResults/
TestResults-*
# perf run artifacts; keep CI scripts and k6 sources in repo
perf/*
!perf/ci/
!perf/k6/

# API keys, tokens, and environment secrets
.env
.env.*
!.env.example
deploy/docker/.env
deploy/docker/.env.*
!deploy/docker/.env.example

# Local ASP.NET settings (connection strings, keys, peppers)
**/appsettings.*.local.json
!**/appsettings.*.local.json.example

# Key material and credential files
*.pem
*.key
*.p12
*.pfx
**/secrets.json
**/api-keys.json
**/apikeys.json
**/*-api-keys.json
*credentials*.json

# Operator config (registry and encrypted upstream API keys)
deploy/docker/config/models.json
deploy/docker/config/models.json.local
deploy/docker/config/upstream-secrets.enc
deploy/docker/config/upstream-secrets.enc.local

# Admin audit trail (FileAuditLogger) — operational record, never committed
**/config/audit-log.jsonl
**/config/audit-log.jsonl.1

# Secret audit artifacts (local only)
gitleaks-report.json
trufflehog-report.json
audit-refs.txt
audit-summary.txt
gitleaks-stdout.txt
trufflehog-stderr.txt

# Deploy runtime state (versions, backups, generated overrides)
deploy/docker/.deploy/
errors/*
