# Copy to deploy/docker/.env and adjust as needed.
# cp .env.example .env

# Compose profiles (comma-separated): observability = Prometheus + Grafana; full = adds mock upstream.
# Leave empty for gpu-gateway only (Postgres + gateway).
# COMPOSE_PROFILES=observability
COMPOSE_PROFILES=

POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432

GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_ADMIN_API_KEY=sk-33pol-dev-admin-key
MOCK_UPSTREAM_PORT=18080

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

ASPNETCORE_ENVIRONMENT=Development

# Browser SPA cross-origin access. Not needed in Development (any origin allowed).
# Required in Production — set your SPA origin(s), e.g. http://localhost:5173
# GATEWAY_CORS_ALLOWED_ORIGIN_0=http://localhost:5173

# Monthly token quota per tenant/anonymous partition (0 = disabled)
# QUOTA_MONTHLY_TOKEN_LIMIT=10000000

# Optional upstream provider API keys (set the envVar referenced in models.json upstreamAuth, or use admin discovery POST body)
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# TOGETHER_API_KEY=...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# FIREWORKS_API_KEY=...
# DASHSCOPE_API_KEY=sk-...
# Custom provider discovery: optional envVar in POST /admin/api/providers/models (omit for unauthenticated local servers)
