# Copy to deploy/docker/.env (used by 33pol-deploy.sh) or the repo root .env (plain docker compose); the
# gateway reads pass-through variables from both locations.
# cp .env.example .env
#
# Values below match docker-compose local-dev defaults — `docker compose up` works without
# a .env file. Override for any non-loopback or production deploy.

# Compose profiles (comma-separated): observability = Prometheus + Grafana; full = adds mock upstream.
# Leave empty for the gateway only (uses an embedded SQLite database — no external DB service).
# COMPOSE_PROFILES=observability
COMPOSE_PROFILES=

# Embedded SQLite database file, persisted on the gateway-data volume at /data. Override only to
# relocate the file; there is no external database server to configure.
# GATEWAY_DB_CONNECTION=Data Source=/data/gateway.db

GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
# Admin UI sign-in at http://localhost:8080/admin (Change key → paste this value).
# The values below are DEV SENTINELS. For Production, generate strong secrets and set
# ASPNETCORE_ENVIRONMENT=Production — the gateway refuses to boot in Production on these defaults.
#   admin key: printf 'sk-33pol-%s' "$(openssl rand -hex 24)"
#   pepper:    openssl rand -hex 24
# GATEWAY_KEY_PEPPER feeds BOTH the bootstrap and security peppers, which must stay identical.
GATEWAY_ADMIN_API_KEY=sk-33pol-dev-local-unsafe
GATEWAY_KEY_PEPPER=dev-pepper-change-me
MOCK_UPSTREAM_PORT=18080
# WireMock's admin API is unauthenticated; loopback unless you explicitly need it on the network.
MOCK_UPSTREAM_BIND=127.0.0.1

PROMETHEUS_PORT=9090
# Prometheus has no auth; loopback by default (set 0.0.0.0 explicitly to expose it).
PROMETHEUS_BIND=127.0.0.1
GRAFANA_PORT=3000
GRAFANA_BIND=127.0.0.1
GRAFANA_ADMIN_USER=admin
# Grafana defaults are for local-dev only. Change GRAFANA_ADMIN_PASSWORD and set
# GRAFANA_BIND=0.0.0.0 explicitly before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=admin

ASPNETCORE_ENVIRONMENT=Development

# /metrics protection. Prometheus in the observability/full profiles authenticates with this token
# (Bearer); it must match what the gateway is configured with (both are fed from this variable).
# The dev stack allows anonymous scraping so `curl :8080/metrics` works; for any non-loopback deploy
# set GATEWAY_METRICS_ALLOW_ANONYMOUS=false and a strong token:  openssl rand -hex 24
GATEWAY_METRICS_SCRAPE_TOKEN=dev-metrics-scrape-token-unsafe
GATEWAY_METRICS_ALLOW_ANONYMOUS=true

# Browser SPA cross-origin access. Not needed in Development (any origin allowed).
# Required in Production — set exact SPA origin(s) in .env (no docker-compose edits).
# Then: docker compose up -d --force-recreate gateway
# GATEWAY_CORS_ALLOWED_ORIGIN_0=https://*.github.io
# GATEWAY_CORS_ALLOWED_ORIGIN_1=http://localhost:5173
# GATEWAY_CORS_ALLOWED_ORIGINS=https://*.github.io,http://localhost:5173

# Monthly token quota per tenant/anonymous partition (0 = disabled)
# QUOTA_MONTHLY_TOKEN_LIMIT=10000000

# Optional upstream provider API keys (set the envVar referenced in models.json upstreamAuth, or use admin discovery POST body)
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# TOGETHER_API_KEY=...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# FIREWORKS_API_KEY=...
# DASHSCOPE_API_KEY=sk-...
# Custom provider discovery: optional envVar in POST /admin/api/providers/models (omit for unauthenticated local servers)
