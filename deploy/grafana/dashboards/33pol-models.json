          "expr": "max by (model) (gateway_circuit_breaker_state{model=~\"$model\"})",
          "legendFormat": "{{model}}"
        }
      ],
      "description": "0 closed, 1 half-open, 2 open. max across replicas, so an open breaker on any replica shows open."
    },
