      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (model) (gateway_bulkhead_inflight{model=~\"$model\"})",
          "legendFormat": "inflight {{model}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (model) (gateway_bulkhead_queued{model=~\"$model\"})",
          "legendFormat": "queued {{model}}"
        }
      ],
      "description": "A queue that stays above zero means the model server, or MaxConcurrentForwardsPerModel, is the bottleneck."
    }
  ],
  "refresh": "10s",
