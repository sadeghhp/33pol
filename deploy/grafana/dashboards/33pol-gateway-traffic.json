          "legendFormat": "{{route}} stream={{stream}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Forward outcomes / s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model, outcome) (rate(gateway_forward_attempts_total{model=~\"$model\"}[5m]))",
          "legendFormat": "{{model}} {{outcome}}"
        }
      ]
    },
    {
      "id": 101,
