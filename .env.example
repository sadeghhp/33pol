# Copy to .env at repo root (or deploy/docker/.env) before: docker compose up -d --build
# cp .env.example .env

# Compose profiles (comma-separated): observability = Prometheus + Grafana; full = adds mock upstream.
# Leave empty for gpu-gateway only (Postgres + gateway).
# COMPOSE_PROFILES=observability
COMPOSE_PROFILES=

POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT=5432

GATEWAY_BIND=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_ADMIN_API_KEY=sk-33pol-dev-admin-key
MOCK_UPSTREAM_PORT=18080

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

ASPNETCORE_ENVIRONMENT=Development

# Browser SPA (Vite/React, etc.). Only required when ASPNETCORE_ENVIRONMENT=Production.
# Use the exact origin from the browser address bar (scheme + host + port, no trailing slash).
# GATEWAY_CORS_ALLOWED_ORIGIN_0=http://localhost:5173
# GATEWAY_CORS_ALLOWED_ORIGIN_1=http://127.0.0.1:5173

# OpenRouter (required if models.json references OPENROUTER_API_KEY — rotate after any Git history exposure)
# Create/revoke keys at https://openrouter.ai/keys then set:
# OPENROUTER_API_KEY=sk-or-...
