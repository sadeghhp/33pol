# Copy to .env at repo root (or deploy/docker/.env) before: docker compose up -d --build
# cp .env.example .env

# Compose profiles (comma-separated): observability = Prometheus + Grafana; full = adds mock upstream.
# Leave empty for gpu-gateway only (Postgres + gateway).
# COMPOSE_PROFILES=observability
COMPOSE_PROFILES=

POSTGRES_USER=gateway
# REQUIRED — set a strong password, e.g. `openssl rand -base64 24 | tr -d '/+='`. Compose refuses to start if empty.
POSTGRES_PASSWORD=
POSTGRES_DB=gateway
# Published-port bind address. Loopback-only by default; set to 0.0.0.0 only to expose on the network.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080
# REQUIRED — set a strong admin key, e.g. `printf 'sk-33pol-%s' "$(openssl rand -hex 24)"`. Compose refuses to start if empty.
GATEWAY_ADMIN_API_KEY=
MOCK_UPSTREAM_PORT=18080

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Change this before exposing Grafana beyond localhost.
GRAFANA_ADMIN_PASSWORD=admin

ASPNETCORE_ENVIRONMENT=Development

# Browser SPA (Vite/React, etc.). Only required when ASPNETCORE_ENVIRONMENT=Production.
# Prefer Admin UI Settings → CORS, or see deploy/docker/docker-compose.cors.override.example.yml.
# Use the exact origin from the browser address bar (scheme + host + port, no trailing slash).
# GATEWAY_CORS_ALLOWED_ORIGIN_0=https://sadeghhp.github.io
# GATEWAY_CORS_ALLOWED_ORIGIN_1=http://localhost:5173
# GATEWAY_CORS_ALLOWED_ORIGIN_2=http://127.0.0.1:5173

# OpenRouter (required if models.json references OPENROUTER_API_KEY — rotate after any Git history exposure)
# Create/revoke keys at https://openrouter.ai/keys then set:
# OPENROUTER_API_KEY=sk-or-...
